+        chunks.push(vec![2; COALESCE_BELOW]);
+        assert_eq!(chunks.seq.len(), 2);
+        // One byte shorter is a short body: it joins the last chunk.
+        chunks.push(vec![3; COALESCE_BELOW - 1]);
+        assert_eq!(chunks.seq.len(), 2);
+        assert_eq!(chunks.len(), 3 * COALESCE_BELOW - 1);
+    }
