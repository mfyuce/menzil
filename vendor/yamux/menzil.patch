+
+    #[test]
+    fn a_fully_read_chunk_still_takes_an_appended_body() {
+        let mut chunks = Chunks::new();
+        chunks.push(vec![1, 2]);
+        let front = chunks.seq.front_mut().unwrap();
+        front.advance(2);
+        assert!(front.is_empty());
+        chunks.push(vec![3]);
